# Admin console password. The session cookie stores sha256(ADMIN_KEY), not this value.
ADMIN_KEY=your-admin-key

# Upstash Redis from the Vercel Marketplace integration.
# Either pair works. UPSTASH_* is used when both pairs are set.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional fallbacks if the integration uses Vercel KV-style names.
KV_REST_API_URL=
KV_REST_API_TOKEN=
