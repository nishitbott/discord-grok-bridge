# Discord Developer Portal → General Information
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_APPLICATION_ID=your-discord-application-id

# Bot token used by `npm run register` only
DISCORD_BOT_TOKEN=your-discord-bot-token

# Guild the /grok command is registered in. Register script defaults to this guild.
DISCORD_GUILD_ID=1141656332609527838

# Role required to run /grok. Runtime defaults to this id when the variable is unset.
AI_ROLE_ID=1555107644518301717

# Endpoint that receives the slash-command wake payload
DISCORD_WAKE_URL=https://example.com/discord-wake
DISCORD_WAKE_KEY=your-wake-shared-key

# Admin console password. The cookie stores sha256(ADMIN_KEY), not this value.
ADMIN_KEY=your-admin-key

# Upstash Redis via the Vercel Marketplace integration
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional fallbacks if the integration uses Vercel KV-style names
KV_REST_API_URL=
KV_REST_API_TOKEN=
