# Admin console password. The session cookie stores sha256(ADMIN_KEY), not this value.
ADMIN_KEY=your-admin-key

# Upstash Redis from the Vercel Marketplace integration.
# Either pair works. UPSTASH_* is used when both pairs are set.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional fallbacks if the integration uses Vercel KV-style names.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Discord gateway on Vercel. Placeholders only. Never commit a real token.
DISCORD_BOT_TOKEN=your-discord-bot-token

# Vercel cron sends Authorization: Bearer ${CRON_SECRET}. The dashboard button uses the same value.
CRON_SECRET=your-cron-secret

# Discord Digest wake webhook. BRIDGE_WAKE_URL and BRIDGE_WAKE_KEY are accepted aliases.
DISCORD_WAKE_URL=https://example.com/discord-wake
DISCORD_WAKE_KEY=your-wake-shared-key

# Snowflake used to detect @mentions. When unset, the gateway uses the logged-in bot id, then the default.
BOT_USER_ID=1555106101828259891

# Role required on the author. Defaults to this id when unset.
AI_ROLE_ID=1555107644518301717

# Guild to watch and backfill. Defaults to this id when unset.
DISCORD_GUILD_ID=1141656332609527838

# Self-chain the next gateway window. Default is enabled. Set to false to stop after one window.
GATEWAY_SELF_CHAIN=true

# Set to "true" to let /api/gateway/run open the Discord gateway (kill switch)
GATEWAY_ENABLED=false
