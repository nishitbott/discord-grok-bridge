# Discord Developer Portal → Bot. Never commit a real token.
DISCORD_BOT_TOKEN=your-discord-bot-token

# Snowflake used to detect @mentions. When unset, the listener uses the logged-in bot id,
# then this default.
BOT_USER_ID=1555106101828259891

# Role required on the author. Defaults to this id when unset.
AI_ROLE_ID=1555107644518301717

# Guild to watch and backfill. Defaults to this id when unset.
DISCORD_GUILD_ID=1141656332609527838

# Discord Digest wake webhook. BRIDGE_WAKE_URL and BRIDGE_WAKE_KEY are accepted aliases.
DISCORD_WAKE_URL=https://example.com/discord-wake
DISCORD_WAKE_KEY=your-wake-shared-key

# Dashboard base URL (no trailing path) and the API key created in /settings.
DASHBOARD_URL=https://your-app.vercel.app
LISTENER_API_KEY=your-listener-api-key

# Durable queue, dedupe, and last-seen files. Railway volume mounts here.
DATA_DIR=./data
